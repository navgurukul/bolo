# Copy to keystore.properties (gitignored) and fill in real values.
# Generate the keystore once with:
#   keytool -genkeypair -v -keystore bolo-release.jks \
#     -alias bolo -keyalg RSA -keysize 2048 -validity 10000
storeFile=bolo-release.jks
storePassword=CHANGE_ME
keyAlias=bolo
keyPassword=CHANGE_ME
